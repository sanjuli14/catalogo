# Copia este archivo como .env y completa los valores (Supabase → Project Settings → API).
# Estas dos son públicas: la seguridad la dan las políticas RLS.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY no va aquí ni en GitHub: se guarda como secreto de Supabase para la Edge Function de invitaciones.
